# ---------------------------------------------------------------- AI provider
# The system runs WITHOUT any key here: a deterministic local provider handles
# analysis, and every Act, Section, Department and Authority is selected from
# the knowledge base by row id. A live model changes the QUALITY OF LANGUAGE,
# never the source of legal facts - so it cannot introduce an invented Act.
#
# Leave every key unset to use the local provider.
#
# EVERY CREDENTIAL BELOW IS SERVER-SIDE ONLY. None is sent to the browser, none
# is written to the database, and this file must never be committed - .env is
# in .gitignore. The settings dialog shows which vendors are configured and
# lets an officer switch between them; it is never shown, and never handles,
# a key.
#
# AI_PROVIDER chooses the vendor at startup:
#   gemini | openai | grok | nvidia | ollama
# When unset, the first configured one is used, in the order gemini, openai,
# grok, nvidia. Ollama is never selected implicitly - it must be named here or
# chosen in the dialog, because it is always "available" and would otherwise
# mask a deployment that simply has no keys.
AI_PROVIDER=

# ---- Google Gemini -------------------------------------------------------
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=

# ---- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=
# Optional. Defaults to text-embedding-3-small.
OPENAI_EMBED_MODEL=

# ---- Grok (xAI) ----------------------------------------------------------
GROK_API_KEY=
# Optional. Defaults to grok-2-latest.
GROK_MODEL=

# ---- NVIDIA NIM ----------------------------------------------------------
# One OpenAI-compatible endpoint serving many open models. The MODEL selects
# between them, so there is a single key here rather than one per model:
# NVIDIA retires model ids over time (a name that worked last month can answer
# 410 Gone), so check build.nvidia.com for the current catalogue and use the
# settings dialog's Test button to confirm one before relying on it.
# Keys are issued at build.nvidia.com.
NVIDIA_API_KEY=
# Optional. Defaults to openai/gpt-oss-20b, which was verified working.
NVIDIA_MODEL=
# Optional. Defaults to https://integrate.api.nvidia.com/v1.
NVIDIA_BASE_URL=

# ---- Ollama (local, no key) ---------------------------------------------
# Runs on the same machine, so nothing leaves the network - the option to use
# when petition text should not be sent to a third party. The daemon must be
# running and the model pulled: `ollama pull llama3.1`.
# Optional. Defaults to http://127.0.0.1:11434/v1.
OLLAMA_BASE_URL=
# Optional. Defaults to llama3.1.
OLLAMA_MODEL=
# Optional. Defaults to nomic-embed-text.
OLLAMA_EMBED_MODEL=


# ================================================== TRANSLATION SERVICE
# Optional. A dedicated translation API, used IN PREFERENCE to the AI model.
#
# Why bother when the model can already translate: the model's quota is shared
# with the analyser and the Copilot, so when it is rate-limited every
# translation silently falls back to the source language - which is how a Tamil
# console ends up showing English subject lines. A translation service has its
# own quota and is faster, so the two stop failing together.
#
# Leave unset to translate with the selected AI model, exactly as before.
#
# TRANSLATE_API_URL   the POST endpoint that performs a translation
# TRANSLATE_API_KEY   your key - server-side only, never sent to the browser
# TRANSLATE_API_AUTH  how the key is sent. Sending it the wrong way looks
#                     exactly like an invalid key, so it is explicit:
#                       bearer  Authorization: Bearer <key>   (most APIs)
#                       header  <TRANSLATE_API_KEY_HEADER>: <key>
#                       query   ?key=<key>                    (Google v2)
#                       body    {"api_key": "<key>"}          (LibreTranslate)
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
TRANSLATE_API_AUTH=bearer
# Only used when TRANSLATE_API_AUTH=header.
TRANSLATE_API_KEY_HEADER=X-API-Key
# Optional. Defaults to 12000 ms.
TRANSLATE_API_TIMEOUT_MS=

# ------------------------------------------------------------- Web search
# Used by the e-Gov Copilot to cite live official sources (Gazette, indiacode,
# tn.gov.in). Without these it falls back to scraping DuckDuckGo's HTML
# endpoint, which has no API contract and is rate-limited - adequate for a
# demonstration, not for production. When search is unavailable the Copilot
# says so and answers from the knowledge base alone.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ------------------------------------------------------------------- OCR
# Tesseract language models. Defaults to tam+eng, which reads a Tamil page, an
# English page, or a page mixing both. The .traineddata files live in the
# repository root: eng.traineddata, tam.traineddata, osd.traineddata.
OCR_LANGS=tam+eng

# --------------------------------------------------------------- Runtime
PORT=4000
JWT_SECRET=change-me-in-production
